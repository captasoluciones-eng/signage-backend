# Copy to .env for local development. On Cloud Run these are set via
# infra/deploy.sh / Terraform env vars instead of a .env file.

GCP_PROJECT=signage-prod
GCP_REGION=us-central1

FIRESTORE_DATABASE=(default)

BQ_DATASET=signage
BQ_LOCATION=US

GCS_ASSETS_BUCKET=signage-prod-assets
GCS_SIGNED_URL_EXPIRATION_SECONDS=900

FIREBASE_PROJECT_ID=signage-prod
ADMIN_EMAIL_ALLOWLIST=jesusbeltran@captasoluciones.com,otro.admin@captasoluciones.com

SCHEDULER_SERVICE_ACCOUNT_EMAIL=signage-scheduler@signage-prod.iam.gserviceaccount.com
# Leave empty in production -- only for local testing of /jobs/* without OIDC.
SCHEDULER_DEV_SHARED_SECRET=local-dev-secret

PLAYLIST_CACHE_TTL_SECONDS=60
HEARTBEAT_FLUSH_INTERVAL_SECONDS=15
HEARTBEAT_FLUSH_MAX_BATCH=500
OFFLINE_THRESHOLD_MINUTES=15
HEARTBEAT_RETENTION_DAYS=7

BUSINESS_TIMEZONE=America/Mazatlan

CORS_ALLOW_ORIGINS=http://localhost:5173,https://signage-admin.web.app

# GCP credentials for local dev (a service account key with Firestore/BigQuery/
# Storage access), NOT used on Cloud Run (which uses the attached runtime SA).
GOOGLE_APPLICATION_CREDENTIALS=./service-account-local.json
