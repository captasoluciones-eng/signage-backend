project_id             = "signage-prod"
region                 = "us-central1"
bq_location            = "US"
backend_image          = "us-central1-docker.pkg.dev/signage-prod/signage/backend:latest"
admin_email_allowlist  = "jesusbeltran@captasoluciones.com"
cors_allow_origins     = "https://signage-admin.web.app"
assets_bucket_name     = "signage-prod-assets"
cdn_domain             = "cdn.signage.example.com"
min_instances          = 1
max_instances          = 10
container_concurrency  = 80
