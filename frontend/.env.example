# Firebase Web SDK config (from Firebase console -> Project settings -> Your apps).
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=signage-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=signage-prod
VITE_FIREBASE_STORAGE_BUCKET=signage-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Backend base URL. Leave empty to use the Vite dev proxy (see vite.config.js)
# or to serve the frontend from the same Cloud Run origin as the API.
VITE_API_BASE_URL=
